<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.just5minbackend.mapper.MallCategoryMapper">

    <sql id="columns">
        id, name, icon, sort, status, created_at, updated_at
    </sql>

    <select id="listAllEnabled" resultType="MallCategory">
        SELECT <include refid="columns"/>
        FROM mall_category
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>

</mapper>
